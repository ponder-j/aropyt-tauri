{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aropyt",
  "version": "1.0.1",
  "identifier": "app.aropyt.tauri",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob: https: http:; font-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost 'self' asset: http://asset.localhost; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "capabilities": [
        "desktop"
      ],
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Markdown editor with live preview",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/styles/": "resources/styles/",
      "../resources/renderer-styles/": "resources/renderer-styles/",
      "../docs/": "docs/",
      "../samples/": "samples/"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mdwn",
          "mdtxt",
          "mdtext",
          "text",
          "txt",
          "rmd"
        ],
        "name": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "SimpChinese"
        ]
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "desktop-template.desktop",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ponder-j/aropyt-tauri/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzOTAzMEM4MjQ4NUZBREUKUldUZStvVWt5RENRVTJHTXF6RWJKa0ZCOFFHL1duWmM2Wm5USDhpSmttV1UzQmt2cXJaMHNYYisK"
    }
  }
}
