{
  "name": "aropyt-tauri",
  "version": "1.0.1",
  "description": "Aropyt Markdown editor on Tauri 2",
  "author": "Aropyt",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponder-j/aropyt-tauri.git"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "node tools/tauri.mjs dev",
    "tauri": "node tools/tauri.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tools/test-platform.mjs && node tools/wordcount-test.mjs && node tools/test-localization.mjs && node tools/test-tauri.mjs",
    "test:app": "node tools/test-tauri.mjs",
    "test:editor": "node tools/test-tauri.mjs --editor",
    "test:spelling": "node tools/test-tauri.mjs --spelling",
    "test:features": "node tools/test-tauri.mjs --features",
    "test:export": "node tools/test-tauri.mjs --export",
    "package": "node tools/tauri.mjs build",
    "package:dir": "node tools/package.mjs",
    "package:mac": "node tools/tauri.mjs build --bundles app,dmg",
    "package:win": "node tools/tauri.mjs build --bundles nsis",
    "package:linux": "node tools/tauri.mjs build --bundles deb,appimage",
    "test:packaged": "node tools/test-tauri.mjs --packaged",
    "dictionaries:prepare": "node tools/prepare-dictionaries.mjs",
    "test:updates": "node --test tools/updates-test.mjs"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.7.0",
    "esbuild": "^0.24.0",
    "fflate": "0.8.2",
    "typescript": "^5.6.0",
    "@tauri-apps/cli": "^2",
    "dictionary-ca": "^3.0.0",
    "dictionary-cs": "^4.0.0",
    "dictionary-da": "^6.0.0",
    "dictionary-de": "^3.0.0",
    "dictionary-de-ch": "^3.0.0",
    "dictionary-el": "^4.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fa": "^2.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-gl": "^3.0.0",
    "dictionary-he": "^2.0.0",
    "dictionary-hr": "^2.0.0",
    "dictionary-hu": "^3.0.0",
    "dictionary-it": "^2.0.0",
    "dictionary-ko": "^2.0.0",
    "dictionary-nb": "^3.0.0",
    "dictionary-nl": "^2.0.0",
    "dictionary-nn": "^3.0.0",
    "dictionary-pl": "^2.0.0",
    "dictionary-pt": "^4.0.0",
    "dictionary-pt-pt": "^2.0.0",
    "dictionary-ro": "^3.0.0",
    "dictionary-ru": "^3.0.0",
    "dictionary-sk": "^2.0.0",
    "dictionary-sl": "^3.0.0",
    "dictionary-sv": "^4.0.0",
    "dictionary-tr": "^2.0.0",
    "dictionary-uk": "^4.0.0",
    "dictionary-vi": "^3.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.0",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.0",
    "@lezer/markdown": "^1.8.1",
    "highlight.js": "^11.10.0",
    "hjson": "^3.2.2",
    "hunspell-asm": "^4.0.2",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "@tauri-apps/api": "^2"
  }
}
